'use client'

import { useRef, useCallback, useEffect } from 'react'
import { io, Socket } from 'socket.io-client'
import { useCallStore, RoomUser } from '@/store/call-store'

const ICE_SERVERS: RTCConfiguration = {
  iceServers: [
    { urls: 'stun:stun.l.google.com:19302' },
    { urls: 'stun:stun1.l.google.com:19302' },
    { urls: 'stun:stun2.l.google.com:19302' },
  ]
}

export function useWebRTC() {
  const socketRef = useRef<Socket | null>(null)
  const peerConnectionsRef = useRef<Map<string, RTCPeerConnection>>(new Map())
  const remoteStreamsRef = useRef<Map<string, MediaStream>>(new Map())

  const {
    userId, userName, currentRoomId,
    localStream, setRoomUsers, addMessage,
    setConnected, setLocalStream, setScreenStream,
  } = useCallStore()

  // Initialize local media
  const initLocalStream = useCallback(async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({
        video: { width: 1280, height: 720, facingMode: 'user' },
        audio: true
      })
      setLocalStream(stream)
      return stream
    } catch (err) {
      console.error('Failed to get local stream:', err)
      // Try audio only
      try {
        const stream = await navigator.mediaDevices.getUserMedia({
          video: false,
          audio: true
        })
        setLocalStream(stream)
        return stream
      } catch (audioErr) {
        console.error('Failed to get audio stream:', audioErr)
        return null
      }
    }
  }, [setLocalStream])

  // Create peer connection for a remote user
  const createPeerConnection = useCallback((remoteSocketId: string, stream: MediaStream) => {
    // Close existing connection if any
    const existingPc = peerConnectionsRef.current.get(remoteSocketId)
    if (existingPc) {
      existingPc.close()
    }

    const pc = new RTCPeerConnection(ICE_SERVERS)

    // Add local tracks
    stream.getTracks().forEach(track => {
      pc.addTrack(track, stream)
    })

    // Handle ICE candidates
    pc.onicecandidate = (event) => {
      if (event.candidate && socketRef.current) {
        socketRef.current.emit('webrtc-ice-candidate', {
          targetSocketId: remoteSocketId,
          candidate: event.candidate.toJSON()
        })
      }
    }

    // Handle remote stream
    pc.ontrack = (event) => {
      const remoteStream = event.streams[0]
      remoteStreamsRef.current.set(remoteSocketId, remoteStream)

      // Update the room users with the stream
      const currentUsers = useCallStore.getState().roomUsers
      const updatedUsers = currentUsers.map(u => {
        if (u.socketId === remoteSocketId) {
          return { ...u, stream: remoteStream }
        }
        return u
      })
      setRoomUsers(updatedUsers)
    }

    // Handle connection state changes
    pc.onconnectionstatechange = () => {
      console.log(`Connection state with ${remoteSocketId}:`, pc.connectionState)
      if (pc.connectionState === 'disconnected' || pc.connectionState === 'failed') {
        peerConnectionsRef.current.delete(remoteSocketId)
        remoteStreamsRef.current.delete(remoteSocketId)
      }
    }

    peerConnectionsRef.current.set(remoteSocketId, pc)
    return pc
  }, [setRoomUsers])

  // Connect to signaling server
  const connect = useCallback(async () => {
    if (socketRef.current?.connected) return

    const socket = io('/?XTransformPort=3003', {
      transports: ['websocket', 'polling'],
      forceNew: true,
      reconnection: true,
      reconnectionAttempts: 10,
      reconnectionDelay: 1000,
      timeout: 10000
    })

    socketRef.current = socket

    socket.on('connect', () => {
      console.log('Connected to signaling server')
      setConnected(true)
    })

    socket.on('disconnect', () => {
      console.log('Disconnected from signaling server')
      setConnected(false)
    })

    // Room users list
    socket.on('room-users', (data: { users: RoomUser[] }) => {
      setRoomUsers(data.users)
    })

    // User joined - create offer
    socket.on('user-joined', async (data: { user: RoomUser; message: any }) => {
      console.log('User joined:', data.user.username)
      const stream = useCallStore.getState().localStream
      if (stream && data.user.socketId !== socket.id) {
        const pc = createPeerConnection(data.user.socketId, stream)
        try {
          const offer = await pc.createOffer()
          await pc.setLocalDescription(offer)
          socket.emit('webrtc-offer', {
            targetSocketId: data.user.socketId,
            offer
          })
        } catch (err) {
          console.error('Error creating offer:', err)
        }
      }
      if (data.message) {
        addMessage(data.message)
      }
    })

    // User left
    socket.on('user-left', (data: { user: RoomUser; message: any }) => {
      const pc = peerConnectionsRef.current.get(data.user.socketId)
      if (pc) {
        pc.close()
        peerConnectionsRef.current.delete(data.user.socketId)
      }
      remoteStreamsRef.current.delete(data.user.socketId)
      if (data.message) {
        addMessage(data.message)
      }
    })

    // WebRTC Offer received
    socket.on('webrtc-offer', async (data: { senderSocketId: string; offer: RTCSessionDescriptionInit }) => {
      const stream = useCallStore.getState().localStream
      if (!stream) return

      const pc = createPeerConnection(data.senderSocketId, stream)
      try {
        await pc.setRemoteDescription(new RTCSessionDescription(data.offer))
        const answer = await pc.createAnswer()
        await pc.setLocalDescription(answer)
        socket.emit('webrtc-answer', {
          targetSocketId: data.senderSocketId,
          answer
        })
      } catch (err) {
        console.error('Error handling offer:', err)
      }
    })

    // WebRTC Answer received
    socket.on('webrtc-answer', async (data: { senderSocketId: string; answer: RTCSessionDescriptionInit }) => {
      const pc = peerConnectionsRef.current.get(data.senderSocketId)
      if (pc) {
        try {
          await pc.setRemoteDescription(new RTCSessionDescription(data.answer))
        } catch (err) {
          console.error('Error handling answer:', err)
        }
      }
    })

    // ICE Candidate received
    socket.on('webrtc-ice-candidate', async (data: { senderSocketId: string; candidate: RTCIceCandidateInit }) => {
      const pc = peerConnectionsRef.current.get(data.senderSocketId)
      if (pc) {
        try {
          await pc.addIceCandidate(new RTCIceCandidate(data.candidate))
        } catch (err) {
          console.error('Error adding ICE candidate:', err)
        }
      }
    })

    // Chat messages
    socket.on('chat-message', (message: any) => {
      addMessage(message)
    })

    // Screen sharing events
    socket.on('screen-share-started', (data: { user: RoomUser }) => {
      // Handle screen share start
    })

    socket.on('screen-share-stopped', (data: { user: RoomUser }) => {
      // Handle screen share stop
    })

    // File sharing
    socket.on('file-shared', (data: any) => {
      useCallStore.getState().addSharedFile(data)
    })

    // Whiteboard
    socket.on('whiteboard-action', (data: any) => {
      useCallStore.getState().addWhiteboardAction(data)
    })

    socket.on('whiteboard-clear', () => {
      useCallStore.getState().clearWhiteboard()
    })

    return socket
  }, [setConnected, setRoomUsers, addMessage, createPeerConnection])

  // Join a room
  const joinRoom = useCallback((roomId: string, roomName: string) => {
    if (!socketRef.current || !userId || !userName) return

    useCallStore.getState().setRoom(roomId, roomName)

    socketRef.current.emit('join-room', {
      roomId,
      userId,
      username: userName,
      avatar: null
    })
  }, [userId, userName])

  // Leave room
  const leaveRoom = useCallback(() => {
    if (!socketRef.current) return

    socketRef.current.emit('leave-room')

    // Close all peer connections
    peerConnectionsRef.current.forEach(pc => pc.close())
    peerConnectionsRef.current.clear()
    remoteStreamsRef.current.clear()

    useCallStore.getState().leaveRoom()
  }, [])

  // Send chat message
  const sendMessage = useCallback((content: string) => {
    if (!socketRef.current) return
    socketRef.current.emit('chat-message', { content })
  }, [])

  // Send whiteboard action
  const sendWhiteboardAction = useCallback((action: any) => {
    if (!socketRef.current) return
    socketRef.current.emit('whiteboard-action', action)
  }, [])

  // Clear whiteboard
  const sendWhiteboardClear = useCallback(() => {
    if (!socketRef.current) return
    socketRef.current.emit('whiteboard-clear')
  }, [])

  // Share file notification
  const notifyFileShared = useCallback((fileInfo: { fileId: string; fileName: string; fileSize: number; mimeType: string }) => {
    if (!socketRef.current) return
    socketRef.current.emit('file-shared', {
      ...fileInfo,
      senderName: userName || 'Unknown'
    })
  }, [userName])

  // Start screen sharing
  const startScreenShare = useCallback(async () => {
    try {
      const screenStream = await navigator.mediaDevices.getDisplayMedia({
        video: { width: 1920, height: 1080 },
        audio: true
      })
      setScreenStream(screenStream)
      socketRef.current?.emit('screen-share-start')
      useCallStore.getState().toggleScreenShare()

      // Listen for screen share stop
      screenStream.getVideoTracks()[0].onended = () => {
        setScreenStream(null)
        socketRef.current?.emit('screen-share-stop')
        useCallStore.getState().toggleScreenShare()
      }

      return screenStream
    } catch (err) {
      console.error('Failed to start screen share:', err)
      return null
    }
  }, [setScreenStream])

  // Stop screen sharing
  const stopScreenShare = useCallback(() => {
    const screenStream = useCallStore.getState().screenStream
    screenStream?.getTracks().forEach(t => t.stop())
    setScreenStream(null)
    socketRef.current?.emit('screen-share-stop')
    useCallStore.getState().toggleScreenShare()
  }, [setScreenStream])

  // Disconnect
  const disconnect = useCallback(() => {
    if (socketRef.current) {
      socketRef.current.emit('leave-room')
      socketRef.current.disconnect()
      socketRef.current = null
    }
    peerConnectionsRef.current.forEach(pc => pc.close())
    peerConnectionsRef.current.clear()
    remoteStreamsRef.current.clear()
    useCallStore.getState().leaveRoom()
  }, [])

  // Cleanup on unmount
  useEffect(() => {
    return () => {
      peerConnectionsRef.current.forEach(pc => pc.close())
      if (socketRef.current) {
        socketRef.current.disconnect()
      }
    }
  }, [])

  return {
    connect,
    joinRoom,
    leaveRoom,
    sendMessage,
    sendWhiteboardAction,
    sendWhiteboardClear,
    notifyFileShared,
    startScreenShare,
    stopScreenShare,
    disconnect,
    initLocalStream,
    socketRef,
    peerConnectionsRef,
    remoteStreamsRef,
  }
}
