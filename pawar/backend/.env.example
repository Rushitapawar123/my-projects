# App
NODE_ENV=development
PORT=5000
# Comma separated list of allowed frontend origins
CLIENT_URLS=http://localhost:3000

# Database
DATABASE_URL=postgresql://pawar:pawar_dev_password@localhost:5432/pawar

# Auth (use long random strings, e.g. `openssl rand -hex 48`)
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Set true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (password reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Pawar <no-reply@pawar.app>

# Firebase Cloud Messaging (service account JSON, single line)
FIREBASE_SERVICE_ACCOUNT=

# Optional in development, required in production. 64 hex chars (openssl rand -hex 32).
# Encrypts two-factor secrets stored in the database.
TWO_FACTOR_ENCRYPTION_KEY=
